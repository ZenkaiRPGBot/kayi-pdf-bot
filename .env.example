# Telegram
BOT_TOKEN=
# Optional when deploying on Render: RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_AUTO_SET=true
DROP_PENDING_UPDATES=false

# Optional startup notification recipients
OWNER_ID=
LOG_CHANNEL_ID=

# Optional Render hosting metadata for owner /usage metrics
RENDER_EMAIL=
RENDER_SERVICE_NAME=kayi-pdf-bot
RENDER_REPO=ZenkaiRPGBot/kayi-pdf-bot
RENDER_USED_HOURS=0.0

# Forced subscription
FSUB_CHANNEL=@KayiBots
FSUB_INVITE_URL=https://t.me/KayiBots
FSUB_CACHE_TTL=45
FSUB_CACHE_MAX=10000
PENDING_ACTION_TTL=900
PENDING_ACTION_MAX=10000

# Optional welcome video file_id from the bot's own chat
WELCOME_VIDEO_FILE_ID=

# File and job limits
MAX_FILE_SIZE_MB=20
MAX_FILES_MERGE=10
MAX_IMAGES=10
MAX_PAGES=200
MAX_TOTAL_PAGES_PER_JOB=500
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=2
MAX_TOTAL_INPUT_MB=60
PROCESSING_TIMEOUT=60
MAX_OUTPUT_SIZE_MB=45
MAX_TOTAL_OUTPUT_MB=60
MAX_SPLIT_OUTPUTS=10
MAX_SPLIT_TOTAL_PAGES=500
SPLIT_INDIVIDUAL_MAX=3
MAX_ZIP_ENTRIES=10
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=6000

# Workspaces and cleanup
MAX_WORKSPACES=20
STALE_WORKSPACE_TTL=7200
WORKSPACE_IDLE_TTL=900
WORKSPACE_CLEANUP_INTERVAL=600
TEMP_ROOT=

# Telegram transport
TELEGRAM_REQUEST_TIMEOUT=60
DOWNLOAD_TIMEOUT=60

# Webhook ingress
WEBHOOK_QUEUE_SIZE=100
MAX_CONCURRENT_UPDATES=16
UPDATE_DEDUP_TTL=600
UPDATE_DEDUP_MAX=2000

# Optional keep-alive (not recommended for Render Free)
ENABLE_SELF_PING=false
PING_URL=
SELF_PING_INITIAL_DELAY=15
SELF_PING_INTERVAL=600

LOG_LEVEL=INFO
